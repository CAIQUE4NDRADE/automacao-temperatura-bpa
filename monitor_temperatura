                        _driver_global = None
                        log.error("  New SAT: não foi possível reconectar.")
                    else:
                        log.info("  New SAT: Chrome recriado e logado com sucesso.")
                else:
                    log.info("  New SAT: Chrome recriado, sessão válida (perfil fixo).")
            else:
                log.error("  New SAT: falha ao criar Chrome no keep-alive.")

    except Exception as e:
        log.warning(f"  New SAT keep-alive falhou: {e}")
        _driver_global = None

    # ── SAP — pula se a macro estiver rodando ─────────────────────────────────
    if _macro_rodando:
