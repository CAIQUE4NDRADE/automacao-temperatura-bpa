_lock_file = None

def _garantir_instancia_unica():
    """
    Cria um arquivo de lock para garantir que apenas uma instância rode por vez.
    Se já houver uma instância rodando, exibe aviso e encerra.
    """
    global _lock_file
    lock_path = BASE_DIR / "monitor.lock"
    try:
        _lock_file = open(lock_path, 'w')
        msvcrt.locking(_lock_file.fileno(), msvcrt.LK_NBLCK, 1)
        _lock_file.write(str(os.getpid()))
        _lock_file.flush()
    except Exception:
        print("=" * 50)
        print("  AVISO: O programa já está rodando!")
        print("  Feche a outra janela antes de abrir nova.")
        print("=" * 50)
        import sys
        sys.exit(1)

# ── Impede suspensão do Windows enquanto o programa estiver rodando ───────────
def _impedir_suspensao():
    """
    Usa powercfg para desativar a suspensão do sistema completamente.
    Mais confiável que SetThreadExecutionState pois funciona mesmo durante sleep().
    """
    try:
        # Desativa suspensão do sistema via powercfg
        subprocess.run(
            ["powercfg", "/change", "standby-timeout-ac", "0"],
            capture_output=True, timeout=5
        )
        subprocess.run(
            ["powercfg", "/change", "standby-timeout-dc", "0"],
            capture_output=True, timeout=5
        )
        # Também usa SetThreadExecutionState como camada extra
        ctypes.windll.kernel32.SetThreadExecutionState(
            0x80000000 | 0x00000001 | 0x00000002
        )
        logging.info("  Sistema configurado para não suspender enquanto o programa rodar.")
    except Exception as e:
        logging.warning(f"  Não foi possível impedir suspensão: {e}")

def _liberar_suspensao():
    """Restaura timeout de suspensão padrão do Windows (20 min) ao encerrar."""
    try:
        subprocess.run(
            ["powercfg", "/change", "standby-timeout-ac", "20"],
            capture_output=True, timeout=5
        )
        subprocess.run(
            ["powercfg", "/change", "standby-timeout-dc", "10"],
            capture_output=True, timeout=5
        )
        ctypes.windll.kernel32.SetThreadExecutionState(0x80000000)
    except Exception:
        pass

