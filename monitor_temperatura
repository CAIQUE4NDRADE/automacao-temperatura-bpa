def _aceitar_popup_sap():
    try:
        import win32gui
        import win32con
        def callback(hwnd, extra):
            titulo = win32gui.GetWindowText(hwnd)
            if any(x in titulo for x in ["SAP", "Script", "Allow", "Permitir", "Macro"]):
                win32gui.PostMessage(hwnd, win32con.WM_KEYDOWN, win32con.VK_RETURN, 0)
                win32gui.PostMessage(hwnd, win32con.WM_KEYUP, win32con.VK_RETURN, 0)
        win32gui.EnumWindows(callback, None)
    except Exception as e:
        log.warning(f"  Não foi possível tratar popup SAP: {e}")


def _fechar_popup_sap_gui():
    try:
        SapGuiAuto = win32com.client.GetObject("SAPGUI")
        app = SapGuiAuto.GetScriptingEngine
        conn = app.Children(0)
        session = conn.Children(0)
        try:
            wnd1 = session.findById("wnd[1]")
            if wnd1:
                session.findById("wnd[1]").sendVKey(0)
                time.sleep(0.5)
        except Exception:
            pass
        session.findById("wnd[0]/tbar[0]/okcd").Text = "/n"
        session.findById("wnd[0]").sendVKey(0)
        time.sleep(1)
    except Exception:
        pass


def _verificar_sap_conectado() -> bool:
    """
    Verifica se o SAP GUI está aberto e com sessão ativa.
    Retorna True se conectado, False se desconectado ou sem sessão.
    """
    try:
        SapGuiAuto = win32com.client.GetObject("SAPGUI")
        app = SapGuiAuto.GetScriptingEngine
        if app.Children.Count == 0:
            log.warning("  SAP: nenhuma conexão ativa.")
            return False
        conn = app.Children(0)
        if conn.Children.Count == 0:
            log.warning("  SAP: conexão sem sessões ativas.")
            return False
        session = conn.Children(0)
        _ = session.findById("wnd[0]")  # testa se a janela existe
        return True
    except Exception as e:
        log.warning(f"  SAP não está conectado: {e}")
        return False


def _preparar_sap_para_macro() -> bool:
    """
    Coloca o SAP dentro da transação ZO3C2 antes de acionar a macro.
    Simula o estado que existe quando o usuário roda manualmente.
    Retorna True se preparado com sucesso, False se SAP indisponível.
    """
    if not _verificar_sap_conectado():
        log.error("  SAP desconectado — macro não pode ser executada sem SAP ativo.")
        return False
    try:
        SapGuiAuto = win32com.client.GetObject("SAPGUI")
        app = SapGuiAuto.GetScriptingEngine
        conn = app.Children(0)
        session = conn.Children(0)
        session.findById("wnd[0]/tbar[0]/okcd").Text = "/nzo3c2"
        session.findById("wnd[0]").sendVKey(0)
        time.sleep(2)
        log.info("  SAP preparado na ZO3C2 para execução da macro.")
        return True
    except Exception as e:
        log.warning(f"  Não foi possível preparar SAP para macro: {e}")
        return False


def _abrir_planilha_correta(excel) -> object:
    """
    Fecha e reabre a planilha correta antes de cada ciclo.
    Garante estado limpo — evita dados pela metade de ciclos anteriores.
    Se a planilha tiver alterações não salvas feitas pelo usuário, salva antes de fechar.
    """
    caminho = CFG["planilha"]["caminho"]

    # Fecha a planilha se já estiver aberta — garante estado limpo
    for i in range(1, excel.Workbooks.Count + 1):
        try:
            wb = excel.Workbooks(i)
            if wb.Name.lower() == NOME_PLANILHA.lower():
                if wb.Saved:
                    # Já salva — fecha sem perder nada
                    log.info(f"  Fechando planilha '{NOME_PLANILHA}' para reabrir limpa...")
                    wb.Close(SaveChanges=False)
                else:
                    # Tem alterações não salvas — salva antes de fechar
                    log.info(f"  Planilha tem alterações não salvas. Salvando antes de fechar...")
                    wb.Save()
                    wb.Close(SaveChanges=False)
                break
        except Exception:
            break

    # Reabre do disco sempre — estado 100% limpo
    log.info(f"  Abrindo planilha: {caminho}")
    return excel.Workbooks.Open(caminho)


def rodar_macro_somente() -> bool:
    """Roda a macro sem alterar nenhum campo — usa os dados já existentes na planilha."""
    global _macro_rodando
    macro = CFG["planilha"]["macro"]
    log.info(f"Rodando macro com dados atuais: {macro}")

    _macro_rodando = True
    try:
        excel = win32com.client.Dispatch("Excel.Application")
        excel.Visible = True
        excel.DisplayAlerts = False

        wb = _abrir_planilha_correta(excel)

        _fechar_popup_sap_gui()
        _aceitar_popup_sap()

        # Verifica SAP antes de tentar — aborta limpo se desconectado
        if not _preparar_sap_para_macro():
            log.error("  SAP indisponível. Macro abortada — será tentada no próximo ciclo.")
            return False

        for tentativa in range(2):
            try:
                excel.Application.Run(f"'{NOME_PLANILHA}'!{macro}")
                wb.Save()
                log.info("  Macro executada com sucesso.")
                return True
            except Exception as e:
                if tentativa == 0:
                    log.warning(f"  Macro falhou (tentativa 1/2), aguardando 10s... ({e})")
                    _fechar_popup_sap_gui()
                    if not _preparar_sap_para_macro():
                        log.error("  SAP desconectou durante retry. Abortando.")
                        return False
                    time.sleep(10)
                else:
                    log.error(f"  Macro falhou (tentativa 2/2), abortando ciclo: ({e})")
                    return False
    except Exception as e:
        log.error(f"Erro ao rodar macro: {e}")
        return False
    finally:
        _macro_rodando = False


def atualizar_planilha_e_rodar_macro(dados_pdf: dict) -> bool:
    global _macro_rodando
    if not dados_pdf:
        log.warning("Nenhum dado de PDF para preencher na planilha.")
        return False

    macro = CFG["planilha"]["macro"]
    celulas = CFG["planilha"]["celulas"]
    log.info(f"Abrindo planilha: {NOME_PLANILHA}")

    _macro_rodando = True
    try:
        excel = win32com.client.Dispatch("Excel.Application")
        excel.Visible = True
        excel.DisplayAlerts = False

        wb = _abrir_planilha_correta(excel)
        ws = wb.Sheets("INICIO")

        for produto, vals in dados_pdf.items():
            if produto not in celulas:
                continue
            cel_temp = celulas[produto]["temp"]
            cel_dens = celulas[produto]["dens"]
            ws.Range(cel_temp).Value = vals["temp"]
            ws.Range(cel_dens).Value = vals["dens"]
            log.info(f"  Preenchido {produto}: Temp={vals['temp']} Dens={vals['dens']}")

        wb.Save()
        _aceitar_popup_sap()

        # Verifica SAP antes de tentar — aborta limpo se desconectado
        if not _preparar_sap_para_macro():
            log.error("  SAP indisponível. Macro abortada — será tentada no próximo ciclo.")
            return False

        log.info(f"  Executando macro: {macro}")
        excel.Application.Run(f"'{NOME_PLANILHA}'!{macro}")
        wb.Save()
        log.info("  Macro executada com sucesso.")
        return True

    except Exception as e:
        log.error(f"Erro ao manipular planilha: {e}")
        return False
    finally:
        _macro_rodando = False


