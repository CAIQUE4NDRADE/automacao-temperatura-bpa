def _matar_chrome_orfao():
    try:
        resultado = subprocess.run(
            ["wmic", "process", "where",
             f"name='chrome.exe' and commandline like '%chrome_profile%'",
             "get", "processid", "/format:value"],
            capture_output=True, text=True, timeout=5
        )
        pids = [
            line.replace("ProcessId=", "").strip()
            for line in resultado.stdout.splitlines()
            if line.startswith("ProcessId=") and line.strip() != "ProcessId="
        ]
        if pids:
            for pid in pids:
                subprocess.run(["taskkill", "/F", "/PID", pid],
                               capture_output=True, timeout=5)
                log.info(f"  Chrome órfão encerrado (PID {pid}).")
            time.sleep(2)
    except Exception as e:
        log.warning(f"  Não foi possível encerrar Chrome órfão: {e}")


def _criar_driver(pasta_download: Path):
    chrome_options = Options()
    chrome_options.add_argument(f"--user-data-dir={PERFIL_CHROME}")
    chrome_options.add_argument("--profile-directory=Default")
    chrome_options.add_experimental_option("detach", True)
    chrome_options.add_experimental_option("prefs", {
        "download.default_directory": str(pasta_download),
        "download.prompt_for_download": False,
        "download.directory_upgrade": True,
        "safebrowsing.enabled": False,
        "safebrowsing.disable_download_protection": True,
        "profile.default_content_settings.popups": 0,
        "profile.default_content_setting_values.automatic_downloads": 1,
    })
    chrome_options.add_argument("--no-sandbox")
    chrome_options.add_argument("--disable-dev-shm-usage")
    chrome_options.add_argument("--window-size=1920,1080")
    chrome_options.add_argument("--disable-popup-blocking")
    chrome_options.add_argument("--safebrowsing-disable-download-protection")

    from webdriver_manager.chrome import ChromeDriverManager
    service = Service(ChromeDriverManager().install())
    driver = webdriver.Chrome(service=service, options=chrome_options)
    driver.execute_cdp_cmd("Page.setDownloadBehavior", {
        "behavior": "allow",
        "downloadPath": str(pasta_download)
    })
    return driver


def _criar_driver_com_retry(pasta_download: Path, tentativas: int = 3):
    for i in range(tentativas):
        try:
            return _criar_driver(pasta_download)
        except Exception as e:
            log.warning(f"  Falha ao criar Chrome (tentativa {i+1}/{tentativas}): {e}")
            if i == 0:
                log.info("  Verificando e encerrando Chrome órfão...")
                _matar_chrome_orfao()
            time.sleep(5)
    log.error("  Não foi possível criar o Chrome após todas as tentativas.")
    return None


def _salvar_cookies(driver):
    cookies = driver.get_cookies()
    COOKIES_FILE.write_text(json.dumps(cookies), encoding="utf-8")
    log.info(f"  Cookies salvos em {COOKIES_FILE}")


def _ja_logado(driver) -> bool:
    return (
        "login" not in driver.current_url.lower()
        and "microsoftonline" not in driver.current_url.lower()
    )


def _aguardar_login_manual(driver) -> bool:
    log.warning("  Sessão expirada. Aguardando login manual no Chrome...")
    log.warning("  >>> FAÇA O LOGIN NO CHROME QUE ABRIU E AGUARDE <<<")
    for _ in range(36):
        time.sleep(5)
        if _ja_logado(driver):
            log.info("  Login detectado!")
            _salvar_cookies(driver)
            return True
    log.error("  Timeout no login manual.")
    return False


def _garantir_driver(pasta_dest: Path):
    global _driver_global

    if _driver_global is not None:
        try:
            _ = _driver_global.title
        except Exception:
            log.warning("  Chrome estava morto. Recriando...")
            _driver_global = None

    if _driver_global is None:
        driver = _criar_driver_com_retry(pasta_dest)
        if driver is None:
            return None
        _driver_global = driver
        log.info("  Novo Chrome criado com perfil fixo.")

    try:
        _driver_global.get(URL_RELATORIO)
        time.sleep(3)
        if not _ja_logado(_driver_global):
            sucesso = _aguardar_login_manual(_driver_global)
            if not sucesso:
                _driver_global = None
                return None
            _driver_global.get(URL_RELATORIO)
            time.sleep(3)
    except Exception as e:
        log.error(f"  Erro ao navegar para o relatório: {e}")
        _driver_global = None
        return None

    return _driver_global


