def _registrar_jobs():
    schedule.clear()
    intervalo = CFG["automacao"]["intervalo_minutos"]
    schedule.every(intervalo).minutes.do(ciclo_hora)
    schedule.every(5).minutes.do(manter_sessoes_vivas)
    schedule.every().day.at("00:00").do(reset_diario)


def _limpar_jobs_atrasados():
    """
    Cancela execuções atrasadas acumuladas no schedule.
    Evita que ciclos que deveriam ter rodado enquanto o anterior
    estava em execução disparem todos de uma vez ao terminar.
    """
    agora = datetime.now()
    for job in schedule.jobs:
        if job.next_run and job.next_run < agora:
            job.next_run = agora


