        self.root.after(1000, self._atualizar_relogio)

    def atualizar_status(self, status: str, duracao: int):
        """Chamado pelo ciclo_hora após cada execução."""
        self._ultimo_status = status
        hora = datetime.now().strftime("%H:%M")

        if status == "OK":
            self._ciclos_ok += 1
            self.lbl_status.config(
                text=f"🟢  Rodando — Último ciclo OK às {hora} ({duracao}s)",
                fg="#2ecc71"
            )
        else:
            self._ciclos_erro += 1
            self.lbl_status.config(
                text=f"🔴  Erro no último ciclo às {hora}",
                fg="#e74c3c"
            )

        self.lbl_ok.config(text=f"✅  Ciclos OK: {self._ciclos_ok}")
        self.lbl_erro.config(text=f"❌  Erros: {self._ciclos_erro}")
        self.lbl_ultimo.config(text=f"🕐  Último ciclo: {hora}")

        # Calcula próximo ciclo
        intervalo = CFG["automacao"]["intervalo_minutos"]
        self._proximo_ciclo = datetime.now().replace(second=0, microsecond=0)
        self._proximo_ciclo = self._proximo_ciclo.replace(
            minute=(self._proximo_ciclo.minute // intervalo + 1) * intervalo % 60
        )
        if self._proximo_ciclo <= datetime.now():
            import datetime as dt_module
            self._proximo_ciclo += dt_module.timedelta(minutes=intervalo)

    def _loop_automacao(self):
        """Loop principal da automação rodando em thread separada."""
        log.info("╔══════════════════════════════════════════╗")
        log.info("║  AUTOMAÇÃO TEMPERATURA BPA - INICIANDO   ║")
        log.info("╚══════════════════════════════════════════╝")

        _impedir_suspensao()
        _registrar_jobs()

        try:
            ciclo_hora()
        except Exception as e:
            log.error(f"Erro no ciclo inicial: {e}")

        _limpar_jobs_atrasados()

        ultimo_tick = datetime.now()
        ultimo_ciclo = datetime.now()

        while self._rodando:
            try:
                agora = datetime.now()
                delta = (agora - ultimo_tick).total_seconds()

                if delta > 120:
                    desde_ultimo_ciclo = (agora - ultimo_ciclo).total_seconds()
                    intervalo_segundos = CFG["automacao"]["intervalo_minutos"] * 60

                    if _diary_falhou:
                        log.warning(f"  Sistema voltou da suspensão ({int(delta)}s). Retentando imediatamente.")
                        try:
                            ciclo_hora()
                            ultimo_ciclo = datetime.now()
                        except Exception as e:
                            log.error(f"  Erro no ciclo pós-suspensão: {e}")
                    elif desde_ultimo_ciclo < intervalo_segundos:
                        log.warning(f"  Sistema voltou da suspensão ({int(delta)}s). Último ciclo há {int(desde_ultimo_ciclo)}s — aguardando.")
                    else:
                        log.warning(f"  Sistema voltou da suspensão ({int(delta)}s). Rodando ciclo.")
                        try:
                            ciclo_hora()
                            ultimo_ciclo = datetime.now()
                        except Exception as e:
                            log.error(f"  Erro no ciclo pós-suspensão: {e}")

                    _registrar_jobs()
                    _limpar_jobs_atrasados()

                ultimo_tick = agora

                jobs_antes = [j for j in schedule.jobs if j.should_run and j.job_func.func == ciclo_hora]
                schedule.run_pending()
                _limpar_jobs_atrasados()

                if jobs_antes:
                    ultimo_ciclo = datetime.now()

                # ── Watchdog: alerta se ficar mais de 70 min sem ciclo ───────
                minutos_sem_ciclo = (datetime.now() - ultimo_ciclo).total_seconds() / 60
                if minutos_sem_ciclo > 70:
                    log.warning(f"  Watchdog: {int(minutos_sem_ciclo)} min sem ciclo completo!")
                    _enviar_telegram(
                        f"\u26a0\ufe0f RAÍZEN BPA \u2014 Sistema parado!\n"
                        f"Último ciclo há {int(minutos_sem_ciclo)} minutos.\n"
                        f"Verifique o computador do turno."
                    )
                    ultimo_ciclo = datetime.now()

            except Exception as e:
                log.error(f"  Erro no loop: {e}. Continuando...")

            time.sleep(30)

        log.info("Automação pausada.")

    def _iniciar(self):
        if not self._rodando:
            self._rodando = True
            self.btn_iniciar.config(state="disabled")
            self.btn_parar.config(state="normal")
            self.lbl_status.config(text="🟡  Iniciando...", fg="#f39c12")
            _enviar_telegram("✅ AutoBPA Monitor iniciado\nTerminal Paulínia")

            self._thread = threading.Thread(target=self._loop_automacao, daemon=True)
            self._thread.start()

    def _parar(self):
        if self._rodando:
            self._rodando = False
            self.btn_iniciar.config(state="normal")
            self.btn_parar.config(state="disabled")
            self.lbl_status.config(text="⚫  Parado", fg="#aaaaaa")
            _enviar_telegram("⏹ AutoBPA Monitor pausado\nTerminal Paulínia")
            _liberar_suspensao()


