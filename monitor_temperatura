def manter_sessoes_vivas():
    global _driver_global
    log.info("── Keep-alive: mantendo sessões ativas ──")

    # ── New SAT ───────────────────────────────────────────────────────────────
    try:
        if _driver_global is not None:
            try:
                _ = _driver_global.title
            except Exception:
                log.warning("  New SAT: Chrome morreu (suspensão?). Recriando...")
                _driver_global = None

        if _driver_global is not None:
            _driver_global.get(URL_RELATORIO)
            time.sleep(2)
            if not _ja_logado(_driver_global):
                log.warning("  New SAT: sessão expirou. Recriando Chrome...")
                _driver_global = None
            else:
                log.info("  New SAT: sessão mantida.")

        if _driver_global is None:
            log.info("  New SAT: recriando Chrome com perfil fixo...")
            pasta_dest = Path(CFG["newsat"]["pasta_download"])
